{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://askmydocs.invalid/schemas/demo-email-v2.json",
    "title": "AskMyDocs case-study email record v2",
    "type": "object",
    "required": [
        "schema_version",
        "fixture_id",
        "dataset_version",
        "company_key",
        "mailbox_key",
        "scenario_type",
        "topic",
        "message_type",
        "thread_id",
        "message_id",
        "in_reply_to",
        "references",
        "to",
        "cc",
        "subject",
        "from_name",
        "from_email",
        "date",
        "sent_at",
        "internal_date",
        "body_text",
        "body_html",
        "headers",
        "attachments",
        "fact_ids",
        "canonical_sources",
        "truth_state",
        "canary_ids",
        "sensitivity"
    ],
    "properties": {
        "schema_version": { "const": "2.0" },
        "fixture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dataset_version": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "company_key": { "type": "string", "minLength": 1 },
        "mailbox_key": { "type": "string", "minLength": 1 },
        "scenario_type": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "message_type": { "enum": ["gold", "thread", "transactional", "report"] },
        "thread_id": { "type": ["string", "null"], "pattern": "^[a-f0-9]{32}$" },
        "message_id": {
            "type": "string",
            "pattern": "^<[a-z0-9-]+\\.[a-f0-9]{64}@fixtures\\.askmydocs\\.invalid>$"
        },
        "in_reply_to": { "type": ["string", "null"] },
        "references": {
            "type": "array",
            "items": { "type": "string" }
        },
        "to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "email" }
        },
        "cc": {
            "type": "array",
            "items": { "type": "string", "format": "email" }
        },
        "subject": { "type": "string", "minLength": 1 },
        "from_name": { "type": "string", "minLength": 1 },
        "from_email": { "type": "string", "format": "email" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$" },
        "sent_at": { "type": "string", "format": "date-time" },
        "internal_date": { "type": "string", "format": "date-time" },
        "body_text": { "type": "string", "minLength": 1 },
        "body_html": { "type": ["string", "null"] },
        "headers": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z0-9-]+$" },
            "additionalProperties": {
                "type": ["string", "number", "integer", "boolean"]
            }
        },
        "attachments": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["filename", "content_base64"],
                "properties": {
                    "filename": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,127}$"
                    },
                    "content_base64": { "type": "string" },
                    "content_type": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
                    }
                },
                "additionalProperties": false
            }
        },
        "fact_ids": {
            "type": "array",
            "items": { "type": "string" }
        },
        "canonical_sources": {
            "type": "array",
            "items": { "type": "string" }
        },
        "truth_state": {
            "enum": ["current", "superseded", "proposal", "incorrect", "corrected"]
        },
        "canary_ids": {
            "type": "array",
            "items": { "type": "string" }
        },
        "sensitivity": { "const": "synthetic_non_real" }
    },
    "additionalProperties": false
}
